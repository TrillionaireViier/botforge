<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <rect width="64" height="64" rx="14" fill="#000000" />
  <!-- Yellow Border -->
  <rect x="2" y="2" width="60" height="60" rx="12" fill="none" stroke="#ffe600" stroke-width="3" />
  
  <!-- Robot Forger Head -->
  <rect x="8" y="10" width="18" height="15" rx="3" fill="#ffe600" stroke="#000000" stroke-width="1.5" />
  <!-- Glowing Cyan Eye -->
  <circle cx="16" cy="17" r="3" fill="#00f0ff" />
  <!-- Antenna -->
  <path d="M17 10 V5" stroke="#ffe600" stroke-width="2.5" stroke-linecap="round" />
  <circle cx="17" cy="4" r="2.5" fill="#ff0055" />
  
  <!-- Robot Arm Holding Hammer -->
  <path d="M17 25 V32 M17 30 L30 24" stroke="#ffe600" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M30 24 L42 14" stroke="#ffe600" stroke-width="4" stroke-linecap="round" />
  
  <!-- Heavy Blacksmith Hammer -->
  <rect x="38" y="8" width="18" height="12" rx="2" fill="#ffffff" stroke="#000000" stroke-width="1.5" transform="rotate(-25 46 14)" />

  <!-- Anvil Base -->
  <path d="M14 48 H50 L44 38 H52 V34 H22 L14 38 Z" fill="#ffe600" stroke="#000000" stroke-width="1" />
  <path d="M24 48 V56 H40 V48" fill="#ffe600" />
  <rect x="18" y="56" width="28" height="4" rx="1" fill="#ffffff" />

  <!-- Flying Dynamic Sparks -->
  <path d="M32 30 L26 22 M38 30 L40 20 M42 34 L52 27 M28 34 L20 28" stroke="#ff0055" stroke-width="3" stroke-linecap="round" />
  <circle cx="26" cy="22" r="1.5" fill="#ffe600" />
  <circle cx="40" cy="20" r="1.5" fill="#ffe600" />
  <circle cx="52" cy="27" r="1.5" fill="#ffe600" />
</svg>